# Copiar a `.env` y completar. `.env` está en .gitignore: nunca commitearlo.
#
# Supabase renombró sus API keys: `publishable` reemplaza a la vieja anon key y
# `secret` reemplaza a service_role. Los valores nuevos empiezan con
# `sb_publishable_` y `sb_secret_`.

SUPABASE_URL=https://<ref>.supabase.co

# Publishable: puede viajar al browser, la protege RLS.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret: saltea RLS por completo. Sólo servidor.
# Nunca ponerle prefijo VITE_ ni PUBLIC_, y nunca importarla desde código de
# cliente: esos prefijos son justamente los que inyectan el valor en el bundle.
SUPABASE_SECRET_KEY=sb_secret_...

# Token personal de la cuenta, para el CLI y la API de Management.
# Se genera en https://supabase.com/dashboard/account/tokens
# Tiene los privilegios de la cuenta entera, no de un proyecto.
SUPABASE_ACCESS_TOKEN=sbp_...

# Dirección pública del storefront: de ahí salen el canonical, el og:url, el
# JSON-LD y el sitemap. Opcional — sin ella se usa la URL del Worker. Acepta el
# dominio suelto, sin esquema.
SITE_URL=

# --- Exposición al browser -------------------------------------------------
# Cada app sólo expone las variables con su prefijo:
#   apps/admin (Vite)   -> VITE_*
#   apps/demo  (Astro)  -> PUBLIC_*
# El resto queda del lado del servidor.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# apps/demo no expone Supabase al browser: el storefront consulta el catálogo
# desde el servidor con la secret key, que lee de `astro:env`. Ver ADR-057.
#
# Qué tienda sirve el storefront. Opcional: por defecto es el dominio de la
# demo, que es el que siembra `pnpm seed`.
# STOREFRONT_DOMAIN=pick-demo.pages.dev

# --- El Worker del Admin (Fase 11) -----------------------------------------
# Con esto cifra la clave de OpenAI de cada comercio. 32 bytes en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sólo servidor, nunca con prefijo VITE_. Si falta, las rutas /api/* del Admin
# responden 503 y el resto del Admin funciona igual, sin IA.
# Rotarla invalida las credenciales ya guardadas: no hay versión de clave.
PICK_AI_MASTER_KEY=
