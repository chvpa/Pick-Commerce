# Copiar a `.env` y completar. `.env` está en .gitignore: nunca commitearlo.
#
# Supabase renombró sus API keys: `publishable` reemplaza a la vieja anon key y
# `secret` reemplaza a service_role. Los valores nuevos empiezan con
# `sb_publishable_` y `sb_secret_`.

SUPABASE_URL=https://<ref>.supabase.co

# Publishable: puede viajar al browser, la protege RLS.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret: saltea RLS por completo. Sólo servidor.
# Nunca ponerle prefijo VITE_ ni PUBLIC_, y nunca importarla desde código de
# cliente: esos prefijos son justamente los que inyectan el valor en el bundle.
SUPABASE_SECRET_KEY=sb_secret_...

# Token personal de la cuenta, para el CLI y la API de Management.
# Se genera en https://supabase.com/dashboard/account/tokens
# Tiene los privilegios de la cuenta entera, no de un proyecto.
SUPABASE_ACCESS_TOKEN=sbp_...

# A qué proyecto le hablan `pnpm db:apply` y `pnpm db:types`. Opcional: sin
# ella usan el ref que traen escrito, el de este repo.
# SUPABASE_PROJECT_REF=

# Dirección pública del storefront: de ahí salen el canonical, el og:url, el
# JSON-LD y el sitemap. Opcional — sin ella se usa la URL del Worker. Acepta el
# dominio suelto, sin esquema.
SITE_URL=

# --- Exposición al browser -------------------------------------------------
# Cada app sólo expone las variables con su prefijo:
#   apps/admin (Vite)                -> VITE_*
#   apps/demo, apps/treeshop (Astro) -> PUBLIC_*
# El resto queda del lado del servidor.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Los storefronts no exponen Supabase al browser: consultan el catálogo desde
# el servidor con la secret key, que leen de `astro:env`. Ver ADR-057.
#
# Qué tienda sirve el storefront: es la llave con la que el Worker busca la
# tienda en `stores.domain`. No confundir con SITE_URL, que es la dirección
# pública. Opcional — cada app trae su default en `src/lib/db.ts`: el Worker
# de la demo, y `sontres.shop` en Treeshop.
# STOREFRONT_DOMAIN=pick-commerce.chvpa-contacto.workers.dev

# --- El Worker del Admin (Fase 11) -----------------------------------------
# Con esto cifra la clave de OpenAI de cada comercio. 32 bytes en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sólo servidor, nunca con prefijo VITE_. Si falta, las rutas /api/* del Admin
# responden 503 y el resto del Admin funciona igual, sin IA.
# Rotarla invalida las credenciales ya guardadas: no hay versión de clave.
PICK_AI_MASTER_KEY=

# --- Lo que el storefront lee por `astro:env` ------------------------------
# Las tres son opcionales porque su ausencia degrada en vez de romper: se
# sigue pudiendo comprar. En local salen de este archivo; en producción van
# cargadas como secretos del Worker. Ver INFRAESTRUCTURA.md.

# Los correos transaccionales. Sin ella la cola de avisos crece y no sale nada.
RESEND_API_KEY=

# De qué dirección salen. Sin un dominio verificado en Resend sólo sirve su
# remitente de prueba, y por eso el default es
# `Pick Commerce <onboarding@resend.dev>`, que entrega únicamente a la casilla
# del dueño de la cuenta. Ver LIMITACIONES.md.
EMAIL_FROM=

# Firma los avisos del gateway simulado. Sin él el método de tarjeta no se
# ofrece y el webhook responde 503. Un valor largo y aleatorio.
PAYMENT_WEBHOOK_SECRET=

# --- El catálogo de Camelot (`pnpm camelot:importar`, ADR-111) -------------
# El proyecto de Supabase de donde sale el catálogo de Treeshop. Sólo lectura y
# sólo desde un script de Node: el Worker no las toca.
CAMELOT_SUPABASE_URL=https://<ref>.supabase.co
CAMELOT_SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- El ERP de Estilo Sport (`pnpm erp:importar`, ADR-085) -----------------
# Al Oracle ORDS no se llega desde un Worker —el `fetch` descarta el puerto no
# estándar y bloquea las IPs crudas—, así que se entra por un proxy propio y el
# importador corre en Node.
LINODE_PROXY_URL=
LINODE_PROXY_SECRET=

# --- Las fotos del ERP (`pnpm erp:imagenes`) -------------------------------
# El proyecto de Supabase donde el cliente tiene hoy sus fotos. El nombre quedó
# de cuando era un proyecto de prueba; es el de origen. Alcanza la clave
# publishable: el script sólo hace select.
TEST_SUPABASE_URL=https://<ref>.supabase.co
TEST_SUPABASE_ANON_KEY=sb_publishable_...

# --- Desplegar sin `wrangler login` ----------------------------------------
# Las toma `wrangler` del entorno, y sólo hacen falta para desplegar a mano.
# Workers Builds no las usa. Ver INFRAESTRUCTURA.md.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
