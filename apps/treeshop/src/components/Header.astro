---
import Container from '@pick/commerce-astro/layout/Container.astro';
import { cn } from '@pick/commerce-ui';
import { CartButton } from '@pick/commerce-ui/cart/CartButton';
import Logotipo from '../assets/logotipo.svg';
import Buscador from './Buscador.astro';
import MenuMobile from './MenuMobile.astro';
import { hayCuentas } from '../lib/db.ts';

interface Props {
  /** Los enlaces del medio. Salen de la página, no del componente. */
  enlaces: readonly { label: string; href: string }[];
  /** La consulta activa, para que el buscador la conserve. */
  consulta?: string;
  /**
   * Transparente y encima del contenido, hasta que se hace scroll. Es para la
   * home, donde el hero ocupa la pantalla y el header va sobre la foto; en el
   * resto sería texto blanco sobre fondo blanco.
   */
  flotante?: boolean;
  class?: string;
}

const { enlaces, consulta = '', flotante = false, class: className } = Astro.props;

const cuentas = await hayCuentas();

/*
 * Un mismo estilo para los tres íconos y el del menú. El hover es un tinte del
 * color actual y no un fondo fijo: sobre el hero el header es blanco y el fondo
 * «hundido» del design system es casi blanco, así que el ícono desaparecía al
 * pasar el mouse.
 */
const ICONO =
  'flex h-10 w-10 cursor-pointer items-center justify-center rounded-full transition-colors ' +
  'hover:bg-current/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
---

{
  /*
   * El header de Treeshop, y no el del paquete.
   *
   * El del paquete pone la navegación pegada al logo y el buscador a la
   * derecha; acá los enlaces van centrados y a la derecha hay tres íconos. Es
   * disposición, que es lo que cambia de una marca a otra, así que vive en la
   * app. Lo que sí es estructural —el comportamiento del menú en teléfono— está
   * en `MenuMobile`, para que el próximo cliente no lo reescriba.
   *
   * Pegajoso siempre. Flotante arranca transparente sobre el hero y, al bajar,
   * gana fondo: un header transparente sobre el catálogo sería ilegible. El
   * cambio lo marca `data-scrolled`, que pone el script de abajo.
   */
}
<header
  id="ts-header"
  data-flotante={flotante ? '' : undefined}
  class={cn(
    'sticky top-0 z-30 w-full transition-colors duration-200',
    flotante
      ? [
          // El margen negativo mete el hero debajo: un `sticky` ocupa lugar en
          // el flujo, y sin esto el hero arrancaría bajo una franja vacía.
          '-mb-16 text-white md:-mb-20',
          'data-scrolled:bg-surface data-scrolled:text-fg data-scrolled:shadow-sm',
        ]
      : 'border-b border-border bg-surface text-fg',
    className,
  )}
>
  <Container class="flex h-16 items-center gap-4 md:h-20">
    {/* Menú en teléfono. Ocupa el lugar del logo en desktop, donde se oculta. */}
    <MenuMobile enlaces={enlaces} class="md:hidden" />

    <a
      href="/"
      aria-label="Treeshop"
      class="flex shrink-0 cursor-pointer items-center rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
    >
      {
        /*
         * El logotipo va inline como componente SVG, no por `<Image>`. Un SVG
         * no gana nada con el optimizador —no hay tamaños que generar— y por el
         * endpoint `/_image` llegaba roto en desarrollo, con el texto
         * alternativo a la vista. Inline no hay pedido, no hay parpadeo, y el
         * rojo de la marca es el rojo de la marca sobre cualquier fondo.
         */
      }
      <Logotipo class="h-6 w-auto md:h-7" aria-hidden="true" />
    </a>

    {
      /* Los enlaces, centrados. `flex-1` a los dos lados los deja en el medio
        aunque el logo y las acciones midan distinto. */
    }
    <nav
      aria-label="Principal"
      class="hidden flex-1 items-center justify-center gap-8 text-sm font-semibold tracking-wide uppercase md:flex"
    >
      {
        enlaces.map((e) => (
          <a
            href={e.href}
            class="cursor-pointer rounded-sm transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          >
            {e.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1 md:ml-0">
      {
        /* Buscar: el ícono abre el formulario en un diálogo. Sin JavaScript
          lleva al catálogo, que tiene el mismo formulario a la vista. */
      }
      <Buscador consulta={consulta} class={ICONO} />

      {
        /*
         * «Mi cuenta», sólo si la tienda tiene cuentas.
         *
         * La condición la resuelve este componente y no la página, por lo mismo
         * que el título lo compone el layout: así la próxima página no puede
         * olvidarse. `hayCuentas()` sale de los ajustes, que se memoizan una vez
         * por request, así que no cuesta una consulta más.
         *
         * Sin el interruptor no hay ícono, y es la regla vieja intacta: un ícono
         * que promete algo que no existe es peor que no tenerlo. Acá «no existe»
         * es literal — `/cuenta` responde 404 en esa tienda.
         */
        cuentas && (
          <a href="/cuenta" aria-label="Mi cuenta" class={ICONO}>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <circle cx="12" cy="8" r="3.5" />
              <path d="M5 19.5a7 7 0 0 1 14 0" />
            </svg>
          </a>
        )
      }
      {
        /* `client:idle`: el contador no compite con el render inicial. El
          `className` pisa el hover del paquete por el mismo motivo que arriba. */
      }
      <CartButton icono className="rounded-full hover:bg-current/10" client:idle />
    </div>
  </Container>
</header>

<script is:inline>
  /*
   * Marca el header cuando la página ya no está arriba de todo. Sólo importa en
   * el flotante —es lo que le da fondo sobre el contenido—, pero el atributo se
   * pone siempre y el CSS decide qué hacer con él.
   *
   * `passive`: el listener no cancela nada y así el scroll no lo espera.
   */
  (function () {
    const header = document.getElementById('ts-header');
    if (!header) return;
    function marcar() {
      header.toggleAttribute('data-scrolled', window.scrollY > 8);
    }
    marcar();
    window.addEventListener('scroll', marcar, { passive: true });
  })();
</script>
