---
import Container from '@pick/commerce-astro/layout/Container.astro';
import { CartView } from '@pick/commerce-ui/cart/CartView';
import Base from '../layouts/Base.astro';

/*
 * On-demand aunque no lea nada de la base.
 *
 * Con Workers Assets, una página prerenderizada se sirve desde el disco **sin
 * ejecutar el Worker**: no habría middleware, así que ni vista ni cookie de
 * sesión. El carrito es el paso entre agregar y empezar el checkout, y un embudo
 * con ese escalón en cero no se puede leer.
 *
 * Lo insidioso es que `astro dev` y `astro preview` sirven todo por SSR, así que
 * el número aparecía en desarrollo y desaparecía al desplegar. `/politicas` y
 * `/preguntas-frecuentes` siguen estáticas y quedan declaradamente fuera de la
 * medición: no están en el embudo.
 */
export const prerender = false;
---

<Base title="Carrito" description="Los productos que agregaste a tu carrito." noindex>
  <Container class="flex max-w-3xl flex-col gap-6 py-12">
    <h1 class="font-display text-2xl font-semibold tracking-tight">Tu carrito</h1>

    {
      /*
      `client:load` y no `client:idle`: quien entra a esta página viene a ver el
      carrito, así que su contenido no puede esperar a que el browser se
      desocupe. El HTML del servidor no lo conoce, vive en localStorage.
    */
    }
    <div class="rounded-md border border-border">
      <CartView client:load />
    </div>
  </Container>
</Base>
