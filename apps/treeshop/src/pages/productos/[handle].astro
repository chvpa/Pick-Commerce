---
import Breadcrumb from '@pick/commerce-astro/navigation/Breadcrumb.astro';
import JsonLd from '@pick/commerce-astro/seo/JsonLd.astro';
import Container from '@pick/commerce-astro/layout/Container.astro';
import ProductGallery from '@pick/commerce-astro/product/ProductGallery.astro';
import ProductCard from '@pick/commerce-astro/product/ProductCard.astro';
import ProductCardBody from '@pick/commerce-astro/product/ProductCardBody.astro';
import ProductCardMedia from '@pick/commerce-astro/product/ProductCardMedia.astro';
import ProductCardTitle from '@pick/commerce-astro/product/ProductCardTitle.astro';
import ProductCarousel from '@pick/commerce-astro/product/ProductCarousel.astro';
import Price from '@pick/commerce-astro/product/Price.astro';
import Reviews from '@pick/commerce-astro/product/Reviews.astro';
import { ProductPurchase } from '@pick/commerce-ui/product/ProductPurchase';
import WishlistHeart from '@pick/commerce-astro/wishlist/WishlistHeart.astro';
import { productJsonLd } from '@pick/commerce-core';

import { catalogo, contextoSeo, recomendados, resenasDe, tiendaActual } from '../../lib/db.ts';
import { anotar } from '../../lib/analytics.ts';
import { estadoDeResena, misFavoritos } from '../../lib/cuenta.ts';
import { paginaDeCuenta } from '../../lib/sesion.ts';
import Base from '../../layouts/Base.astro';

/*
 * On-demand y sin `getStaticPaths`: prerenderizar el catálogo obligaría a
 * reconstruir el sitio con cada precio o cada cambio de stock, y en un catálogo
 * grande el build crecería sin techo. Ver ADR-057.
 */
export const prerender = false;

const tienda = await tiendaActual();
const product = await catalogo().porHandle(tienda.storeId, Astro.params.handle!);

if (!product) {
  /*
   * La página 404 del sitio, con el status que corresponde. Devolver una
   * respuesta vacía daría el código correcto y una pantalla en blanco; dejar
   * pasar un 200 con "no encontrado" haría que un buscador indexara la página
   * de error como si fuera contenido.
   */
  const pagina = await Astro.rewrite('/404');
  return new Response(pagina.body, { status: 404, headers: pagina.headers });
}

/*
 * Se anota después del 404, no antes: un handle que no existe no es una vista de
 * producto. El `Astro.rewrite` de arriba corre la cadena de middleware otra vez,
 * así que anotar antes habría dado además una vista con el producto en null.
 */
/*
 * Cómo está el corazón para quien ya entró.
 *
 * `undefined` sin sesión, y ahí manda `localStorage`: el HTML es el mismo para
 * todos y la island lo corrige al hidratar. Con sesión se resuelve acá, que es
 * lo que evita el parpadeo de un corazón que aparece vacío y se llena solo.
 *
 * Un fallo leyendo esto no puede tumbar un PDP, que es la página que vende: se
 * cae a `undefined` y el corazón se comporta como el de alguien sin cuenta.
 */
let guardadoEnLaCuenta: boolean | undefined;
const { habilitado: hayCuenta, token: tokenDeCuenta } = await paginaDeCuenta(Astro.cookies);
if (hayCuenta && tokenDeCuenta) {
  try {
    guardadoEnLaCuenta = (await misFavoritos(tokenDeCuenta)).includes(product.id);
  } catch (error) {
    console.error('[pdp] no se pudo leer lo guardado', error);
  }
}

/*
 * Las reseñas (ADR-140).
 *
 * Las publicadas se leen siempre, con la secret key: son parte de la página y no
 * dependen de quién mire. Lo que sí depende es si a quien mira se le ofrece
 * escribir una, y eso sale de su sesión: sin cuenta llega todo en false y no se
 * ofrece nada.
 */
const resenas = await resenasDe(product.id);
const miResena =
  hayCuenta && tokenDeCuenta
    ? await estadoDeResena(tokenDeCuenta, product.id)
    : { puede: false, yaEscribio: false, pendiente: false };

/* `?resena=` lo pone el redirect del POST, y es lo único que se acepta de ahí. */
const avisoDeResena = Astro.url.searchParams.get('resena');
const aviso = avisoDeResena === 'ok' ? 'ok' : avisoDeResena === 'error' ? 'error' : undefined;

anotar(Astro.locals, 'product_view', Astro.url.pathname, {
  handle: product.handle,
  productId: product.id,
});

/*
 * Y de dónde vino, si vino de una sección de la portada. `?s=` lo pone el
 * enlace; acá se comprueba que sea un uuid antes de anotarlo, porque llega de la
 * URL y cualquiera puede escribir lo que quiera ahí.
 */
const desdeSeccion = Astro.url.searchParams.get('s') ?? '';
if (/^[0-9a-f-]{36}$/i.test(desdeSeccion)) {
  anotar(Astro.locals, 'section_click', Astro.url.pathname, {
    sectionId: desdeSeccion,
    productId: product.id,
  });
}

/* Los swatches los aporta el storefront: el catálogo guarda "Azul", no un hex. */
const COLOR_SWATCHES = { Azul: '#2f4858', Negro: '#26262b', Blanco: '#e8e6e1', Verde: '#3f5f46' };

/* Una oferta por variante, con su precio y stock reales. Ver ADR-047. */
const jsonLd = productJsonLd(product, await contextoSeo());

/*
 * La tira de relacionados. Va después del producto porque necesita su id, y no
 * bloquea nada más: si falla, `recomendados()` devuelve vacío y la página sigue
 * siendo la que vende.
 */
const relacionados = await recomendados([product.id]);
---

<Base
  title={product.title}
  description={product.description ??
    `${product.title}${product.brand ? ` de ${product.brand}` : ''}. Comprá online con envío a todo el país.`}
  image={product.images[0]?.url}
  imageAlt={product.images[0]?.alt}
  type="product"
>
  <JsonLd slot="head" data={jsonLd} />
  <Container class="py-6">
    <Breadcrumb items={[{ label: 'Catálogo', href: '/catalogo' }, { label: product.title }]} />
  </Container>

  <Container class="grid gap-10 pb-12 md:grid-cols-2 md:gap-16">
    <ProductGallery images={product.images} title={product.title} id={product.handle} />

    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        {product.brand && <p class="text-sm text-fg-subtle">{product.brand}</p>}
        <h1 class="font-display text-2xl font-semibold tracking-tight">{product.title}</h1>
      </div>

      {
        /*
        El corazón sólo existe donde existen las cuentas: sin el interruptor,
        guardar llevaría a una pantalla que responde 404.
      */
      }
      {
        hayCuenta && (
          <WishlistHeart
            productId={product.id}
            guardadoEnLaCuenta={guardadoEnLaCuenta}
            etiqueta="Guardar"
            class="self-start"
          />
        )
      }

      {
        /*
        Única island de la página. Contiene precio, selector y alta al carrito
        porque los tres comparten estado, y Astro no lo pasa entre islands.

        `client:load` y no `client:idle`: es la acción principal de la página.
        Con `idle`, en un dispositivo ocupado el botón se ve pero todavía no
        responde, y el click se pierde sin ninguna señal.
      */
      }
      <ProductPurchase
        client:load
        productTitle={product.title}
        imageUrl={product.images[0]?.url}
        variants={product.variants}
        swatches={COLOR_SWATCHES}
      />
    </div>
  </Container>

  {
    /*
     * Lo que miró quien miró esto (v2 Fase 4, ADR-127).
     *
     * **Con precio**, al revés que «Seguí viendo»: ahí la tira es un atajo a algo
     * que la persona ya vio, acá es una vitrina, y una vitrina sin precio no
     * vende. Sale del mismo documento que el catálogo, así que la promoción y el
     * tachado son los mismos.
     *
     * **Sin datos no hay tira**, ni título ni carrusel vacío: una tienda recién
     * abierta no tiene co-vistas, y el arreglo llega vacío.
     */
  }
  {
    /*
     * Las reseñas, antes de los relacionados: es lo que ayuda a decidir **este**
     * producto, y los relacionados son para irse a otro.
     */
  }
  <Container class="pb-12">
    <Reviews
      resenas={resenas}
      productId={product.id}
      puede={miResena.puede}
      yaEscribio={miResena.yaEscribio}
      pendiente={miResena.pendiente}
      aviso={aviso}
      locale={tienda.locale}
    />
  </Container>

  {
    relacionados.length > 0 && (
      <Container class="pb-12">
        <ProductCarousel label="Quien vio esto, vio" controles id="pista-relacionados">
          {relacionados.map((p) => (
            <ProductCard>
              <ProductCardMedia image={p.images[0]} />
              <ProductCardBody>
                {p.brand && <p class="text-xs text-fg-subtle">{p.brand}</p>}
                <ProductCardTitle href={`/productos/${p.handle}`}>{p.title}</ProductCardTitle>
                {p.variants[0] && (
                  <Price value={p.variants[0].price} compareAt={p.variants[0].compareAtPrice} />
                )}
              </ProductCardBody>
            </ProductCard>
          ))}
        </ProductCarousel>
      </Container>
    )
  }
</Base>
