---
import Header from '@pick/commerce-astro/layout/Header.astro';
import Footer from '@pick/commerce-astro/layout/Footer.astro';
import Banner from '@pick/commerce-astro/content/Banner.astro';
import SearchInput from '@pick/commerce-astro/catalog/SearchInput.astro';
import SeoHead from '@pick/commerce-astro/seo/SeoHead.astro';
/* Las islands entran por subpath, no por el barrel: si entran por
   `@pick/commerce-ui`, Vite las mete a todas en un solo chunk y cada página
   descarga las que no usa. Ver ADR-040. */
import { CartButton } from '@pick/commerce-ui/cart/CartButton';
import { CartDrawer } from '@pick/commerce-ui/cart/CartDrawer';
import { ANUNCIO, seoContexto } from '../lib/store-config.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Imagen para compartir. Sin ella el link sale sin miniatura. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
}

const { title, description, image, imageAlt, type, noindex } = Astro.props;

/* El buscador del header conserva la consulta activa: en el catálogo muestra
   qué se buscó, en el resto arranca vacío. */
const consulta = Astro.url.searchParams.get('q') ?? '';
const STORE_NAME = seoContexto.storeName;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={title}
      description={description}
      siteUrl={seoContexto.siteUrl}
      storeName={STORE_NAME}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col bg-surface text-fg antialiased">
    {ANUNCIO && <Banner href={ANUNCIO.href}>{ANUNCIO.texto}</Banner>}

    <Header storeName={STORE_NAME}>
      <a slot="nav" href="/catalogo" class="cursor-pointer hover:underline">Catálogo</a>
      {/* `client:idle`: el contador del carrito no compite con el render inicial. */}
      <CartButton slot="cart" client:idle />
      <SearchInput slot="search" value={consulta} />
    </Header>

    <main class="flex-1">
      <slot />
    </main>

    <Footer storeName={STORE_NAME}>
      <nav aria-label="Enlaces del pie" class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href="/catalogo" class="cursor-pointer text-fg-muted hover:text-fg hover:underline">
          Catálogo
        </a>
        <a
          href="/preguntas-frecuentes"
          class="cursor-pointer text-fg-muted hover:text-fg hover:underline"
        >
          Preguntas frecuentes
        </a>
        <a href="/politicas" class="cursor-pointer text-fg-muted hover:text-fg hover:underline">
          Políticas
        </a>
      </nav>
    </Footer>

    {/* Vive en el layout, no en el PDP: se abre desde cualquier página. */}
    {
      /*
      `client:load`: el drawer es el receptor del evento de alta al carrito, así
      que tiene que estar escuchando antes de que el botón de compra pueda
      pulsarse. Con `idle` la espera es indefinida y un alta que llega antes se
      pierde: el drawer abre vacío.
    */
    }
    <CartDrawer client:load />
  </body>
</html>
