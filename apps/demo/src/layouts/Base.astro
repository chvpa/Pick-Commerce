---
import Header from '@pick/commerce-astro/layout/Header.astro';
import Footer from '@pick/commerce-astro/layout/Footer.astro';
/* Import por subpath, no desde el barrel: si entran por `@pick/commerce-ui`
   Vite las mete a todas en un solo chunk y cada página descarga las islands
   que no usa. */
import { CartButton } from '@pick/commerce-ui/cart/CartButton';
import { CartDrawer } from '@pick/commerce-ui/cart/CartDrawer';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const STORE_NAME = 'Pick Demo';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={Astro.url.pathname} />
  </head>
  <body class="flex min-h-dvh flex-col bg-surface text-fg antialiased">
    <Header storeName={STORE_NAME}>
      <a slot="nav" href="/catalogo" class="cursor-pointer hover:underline">Catálogo</a>
      {/* `client:idle`: el contador del carrito no compite con el render inicial. */}
      <CartButton slot="actions" client:idle />
    </Header>

    <main class="flex-1">
      <slot />
    </main>

    <Footer storeName={STORE_NAME} />

    {/* Vive en el layout, no en el PDP: se abre desde cualquier página. */}
    <CartDrawer client:idle />
  </body>
</html>
