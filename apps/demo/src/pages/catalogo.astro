---
import Badge from '@pick/commerce-astro/primitives/Badge.astro';
import JsonLd from '@pick/commerce-astro/seo/JsonLd.astro';
import Container from '@pick/commerce-astro/layout/Container.astro';
import FacetAccordion from '@pick/commerce-astro/catalog/FacetAccordion.astro';
import Pagination from '@pick/commerce-astro/catalog/Pagination.astro';
import Price from '@pick/commerce-astro/product/Price.astro';
import ProductCard from '@pick/commerce-astro/product/ProductCard.astro';
import ProductCardBody from '@pick/commerce-astro/product/ProductCardBody.astro';
import ProductCardMedia from '@pick/commerce-astro/product/ProductCardMedia.astro';
import ProductCardTitle from '@pick/commerce-astro/product/ProductCardTitle.astro';
import ProductGrid from '@pick/commerce-astro/product/ProductGrid.astro';
import SortSelect from '@pick/commerce-astro/catalog/SortSelect.astro';
import { itemListJsonLd, queryCatalog, type CatalogSort } from '@pick/commerce-core';
import { seoContexto } from '../lib/store-config.ts';
import { ClientRouter } from 'astro:transitions';
import Base from '../layouts/Base.astro';
import { mockProducts } from '../lib/mock-catalog.ts';

/*
 * Ruta on-demand: los filtros, el orden y la paginación se resuelven en el
 * servidor, como exige ADR-024. El resto del sitio sigue prerenderizado.
 */
export const prerender = false;

const FACET_NAMES = ['categoria', 'brand', 'color', 'size'] as const;
const FACET_LABELS: Record<string, string> = {
  categoria: 'Categoría',
  brand: 'Marca',
  color: 'Color',
  size: 'Talle',
};
const PER_PAGE = 12;
const SORTS: readonly CatalogSort[] = ['relevance', 'price-asc', 'price-desc', 'title-asc'];

const url = Astro.url;
const search = url.searchParams.get('q') ?? '';
const rawSort = url.searchParams.get('sort') ?? 'relevance';
const sort: CatalogSort = SORTS.includes(rawSort as CatalogSort)
  ? (rawSort as CatalogSort)
  : 'relevance';
const page = Number.parseInt(url.searchParams.get('page') ?? '1', 10) || 1;

/* Sólo se aceptan las facetas declaradas: un parámetro cualquiera de la URL no
   se convierte en filtro. */
const filters: Record<string, string[]> = {};
for (const name of FACET_NAMES) {
  const values = url.searchParams.getAll(name);
  if (values.length > 0) filters[name] = values;
}

const result = queryCatalog(mockProducts, { filters, sort, search, page, perPage: PER_PAGE });
const activeCount = Object.values(filters).reduce((n, values) => n + values.length, 0);

const jsonLd = itemListJsonLd(result.items, seoContexto, 'Catálogo');

/*
 * Una combinación de filtros no es una página nueva: indexarlas multiplica
 * URLs casi idénticas y dispersa la autoridad del catálogo. Se indexa el
 * catálogo limpio y nada más; `follow` deja que los productos sigan
 * descubriéndose desde acá.
 */
const noindex = activeCount > 0 || search !== '' || page > 1;
---

{
  /*
  ClientRouter sólo en esta ruta: intercepta el submit del form GET y los links
  de paginación, así los filtros se resuelven en el servidor pero sin recarga
  completa. El resto del sitio no paga esos ~5,6 KB.
  El total va en el <title> porque el announcer del router lo lee al navegar.
*/
}
<Base
  title={`Catálogo (${result.total}) · Pick Demo`}
  description="Catálogo completo: filtrá por marca, color y talle, con precios y disponibilidad."
  noindex={noindex}
>
  <JsonLd slot="head" data={jsonLd} />
  <ClientRouter />
  <Container class="flex flex-col gap-6 py-10">
    <div class="flex flex-col gap-3">
      <h1 class="font-display text-2xl font-semibold tracking-tight">Catálogo</h1>
      {
        search !== '' && (
          <p class="flex flex-wrap items-center gap-2 text-sm text-fg-muted">
            <span>
              Resultados para <span class="text-fg font-medium">“{search}”</span>
            </span>
            <a href="/catalogo" class="underline hover:text-fg">
              Quitar búsqueda
            </a>
          </p>
        )
      }
    </div>

    <div class="grid gap-8 md:grid-cols-[16rem_1fr]">
      {
        /*
        Un solo form GET para facetas y orden: sin JavaScript el usuario pulsa
        "Aplicar" y la consulta queda en la URL, compartible y recargable.
        `page` queda fuera a propósito — cambiar un filtro vuelve a la 1.
      */
      }
      {
        /*
        El form va vacío y los controles se asocian con `form="plp"`. Así el
        mismo panel sirve de sidebar en desktop y de disclosure en mobile sin
        duplicar inputs, que mandaría cada valor dos veces.
        `page` queda fuera a propósito: cambiar un filtro vuelve a la página 1.
      */
      }
      <form id="plp" method="get" action="/catalogo" class="hidden">
        {
          /* Sólo si hay búsqueda: si no, cada filtro dejaría un `?q=` vacío en
            una URL que se comparte. */
        }
        {search !== '' && <input type="hidden" name="q" value={search} />}
      </form>

      {
        /*
        El mismo <dialog> es sidebar en desktop y sheet en mobile. CSS puede
        mostrar un <dialog> cerrado —la regla del navegador es `display:none`,
        que sí se sobreescribe—, a diferencia de <details>, que oculta su
        contenido con content-visibility en un slot interno. Ver ADR-045 y 049.
      */
      }
      <button
        type="button"
        id="plp-toggle"
        aria-haspopup="dialog"
        aria-controls="plp-panel"
        aria-expanded="false"
        class="mb-3 flex cursor-pointer items-center justify-between rounded-md border border-border px-4 py-2 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:hidden"
      >
        <span>{activeCount > 0 ? `Filtros (${activeCount})` : 'Filtros'}</span>
        <span aria-hidden="true">▾</span>
      </button>

      <dialog id="plp-panel" class="plp-panel" aria-label="Filtros" open>
        <div class="flex items-center justify-between border-b border-border px-5 py-4 md:hidden">
          <h2 class="text-base font-semibold">Filtros</h2>
          <button
            type="button"
            id="plp-cerrar"
            aria-label="Cerrar filtros"
            class="cursor-pointer rounded-md px-2 py-1 text-sm hover:bg-surface-sunken focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            <span aria-hidden="true">✕</span>
          </button>
        </div>

        <div class="flex flex-col gap-1 overflow-y-auto px-5 py-2 md:px-0 md:py-0">
          <div class="hidden items-center justify-between pb-2 md:flex">
            <h2 class="text-sm font-semibold">Filtros</h2>
            {
              activeCount > 0 && (
                <a href="/catalogo" class="text-xs text-fg-muted underline hover:text-fg">
                  Limpiar ({activeCount})
                </a>
              )
            }
          </div>

          {
            result.facets
              .filter((facet) => FACET_NAMES.includes(facet.name as (typeof FACET_NAMES)[number]))
              .map((facet) => (
                <FacetAccordion facet={facet} form="plp" label={FACET_LABELS[facet.name]} />
              ))
          }
        </div>

        {
          /* El pie NO es md:hidden: sin JavaScript, "Aplicar" es la única forma
            de enviar los filtros, también en desktop. */
        }
        <div class="flex flex-col gap-2 border-t border-border px-5 py-4 md:border-0 md:px-0">
          {
            activeCount > 0 && (
              <a
                href="/catalogo"
                class="text-center text-xs text-fg-muted underline hover:text-fg md:hidden"
              >
                Limpiar filtros ({activeCount})
              </a>
            )
          }
          {
            /*
            "Aplicar" es para quien no tiene JavaScript: con JS los filtros se
            aplican al tocarlos y el botón sobra, así que el script lo oculta y
            muestra en su lugar uno que sólo cierra el sheet.
          */
          }
          <button
            form="plp"
            type="submit"
            id="plp-aplicar"
            class="h-10 cursor-pointer rounded-md bg-accent px-4 text-sm font-medium text-accent-fg hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            Aplicar
          </button>
          <button
            type="button"
            id="plp-ver"
            hidden
            class="h-10 cursor-pointer rounded-md bg-accent px-4 text-sm font-medium text-accent-fg hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:hidden"
          >
            {`Ver ${result.total} ${result.total === 1 ? 'producto' : 'productos'}`}
          </button>
        </div>
      </dialog>

      <div class="flex flex-col gap-6">
        {
          /* El orden vive en el PLP y no dentro del panel: es una decisión
            frecuente y no debería exigir abrir un sheet para tomarla. */
        }
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-sm text-fg-muted" aria-live="polite">
            {
              result.total === 0
                ? 'No encontramos productos con esos filtros'
                : `${result.total} ${result.total === 1 ? 'producto' : 'productos'}`
            }
          </p>
          <SortSelect value={sort} form="plp" />
        </div>

        {
          result.total === 0 ? (
            <div class="flex flex-col items-start gap-3 rounded-md border border-border p-6">
              <p class="text-sm text-fg-muted">
                Probá quitar algún filtro o buscar con otras palabras.
              </p>
              <a href="/catalogo" class="text-sm underline">
                Ver todo el catálogo
              </a>
            </div>
          ) : (
            <ProductGrid>
              {result.items.map((product, index) => {
                const variant = product.variants[0];
                if (!variant) return null;
                const soldOut = product.variants.every((v) => v.availableQuantity === 0);

                return (
                  <ProductCard>
                    <ProductCardMedia image={product.images[0]} priority={index < 4}>
                      {soldOut && <Badge slot="badge">Sin stock</Badge>}
                    </ProductCardMedia>
                    <ProductCardBody>
                      {product.brand && <p class="text-xs text-fg-subtle">{product.brand}</p>}
                      <ProductCardTitle href={`/productos/${product.handle}`}>
                        {product.title}
                      </ProductCardTitle>
                      <Price value={variant.price} compareAt={variant.compareAtPrice} />
                    </ProductCardBody>
                  </ProductCard>
                );
              })}
            </ProductGrid>
          )
        }

        <Pagination page={result.page} pageCount={result.pageCount} url={url} />
      </div>
    </div>
  </Container>
</Base>

<style>
  /*
   * El panel nace `open`. Sin JavaScript queda abierto y no-modal, o sea
   * visible dentro del flujo: los filtros siguen alcanzables en mobile, donde
   * el botón que los abriría no tendría handler.
   *
   * `:modal` distingue los dos estados. Ninguna regla declara `display` fuera
   * de ellos: el navegador oculta un <dialog> cerrado y un `display` suelto le
   * ganaría, dejando el sheet visible y tapando el botón que debe abrirlo.
   */
  .plp-panel {
    border: 0;
    padding: 0;
    color: inherit;
    background: transparent;
  }

  /* Abierto en el flujo: sidebar en desktop, y el fallback sin JavaScript. */
  .plp-panel[open]:not(:modal) {
    display: flex;
    flex-direction: column;
    position: static;
    margin: 0;
    width: auto;
    max-width: none;
    max-height: none;
    align-self: start;
  }

  /* Sheet desde abajo, sólo cuando se abre como modal. */
  .plp-panel:modal {
    display: flex;
    flex-direction: column;
    margin: auto auto 0;
    width: 100%;
    max-width: none;
    max-height: 85dvh;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    background: var(--color-surface);
    color: var(--color-fg);
  }

  .plp-panel::backdrop {
    background: rgb(0 0 0 / 0.4);
  }
</style>

<script is:inline>
  /*
   * Mejora progresiva. Sin este script el panel queda abierto y no-modal, así
   * que los filtros se ven y "Aplicar" los envía. Con él, en mobile el panel
   * pasa a ser un sheet que abre el botón.
   *
   * `astro:page-load` y no un listener suelto: ClientRouter reemplaza el DOM al
   * filtrar, y los nodos capturados una sola vez dejarían de existir.
   */
  const CLAVE = 'plp:estado';

  function inicializar() {
    const panel = document.getElementById('plp-panel');
    const toggle = document.getElementById('plp-toggle');
    if (!panel || !toggle) return;

    const mobile = window.matchMedia('(max-width: 767px)');
    const esSheet = () => panel.open && panel.matches(':modal');

    // Con JavaScript los filtros se aplican al tocarlos: "Aplicar" sobra, y en
    // su lugar va uno que sólo cierra el sheet.
    const aplicar = document.getElementById('plp-aplicar');
    const ver = document.getElementById('plp-ver');
    if (aplicar) aplicar.hidden = true;
    if (ver) ver.hidden = false;

    // Invariante: en mobile el panel sólo está abierto como sheet; en desktop
    // siempre abierto y en el flujo.
    function sincronizar() {
      if (mobile.matches) {
        if (panel.open && !panel.matches(':modal')) panel.close();
      } else {
        if (panel.open && panel.matches(':modal')) panel.close();
        if (!panel.open) panel.show();
      }
      toggle.setAttribute('aria-expanded', String(esSheet()));
    }

    toggle.addEventListener('click', () => {
      if (!panel.open) panel.showModal();
      toggle.setAttribute('aria-expanded', 'true');
    });

    // Click en el backdrop: el evento llega al propio <dialog> y no a su
    // contenido, así que comparar el target alcanza para distinguirlo.
    panel.addEventListener('click', (event) => {
      if (event.target === panel && panel.matches(':modal')) panel.close();
    });

    const cerrar = () => panel.open && panel.close();
    document.getElementById('plp-cerrar')?.addEventListener('click', cerrar);
    ver?.addEventListener('click', cerrar);
    panel.addEventListener('close', sincronizar);
    mobile.addEventListener('change', sincronizar);

    sincronizar();

    // ClientRouter reemplaza el DOM: sin esto, tocar un filtro cierra el sheet
    // y manda el scroll y el foco al principio.
    const crudo = sessionStorage.getItem(CLAVE);
    if (crudo) {
      sessionStorage.removeItem(CLAVE);
      const estado = JSON.parse(crudo);
      if (estado.sheet && mobile.matches && !panel.matches(':modal')) {
        panel.close();
        panel.showModal();
        toggle.setAttribute('aria-expanded', 'true');
      }
      window.scrollTo({ top: estado.y ?? 0, behavior: 'instant' });
      // Sin preventScroll el foco vuelve a desplazar la página.
      if (estado.id) document.getElementById(estado.id)?.focus({ preventScroll: true });
    }
  }

  function alCambiarFiltro(event) {
    const target = event.target;
    if (!target || !target.form || target.form.id !== 'plp') return;
    const panel = document.getElementById('plp-panel');
    sessionStorage.setItem(
      CLAVE,
      JSON.stringify({
        id: target.id,
        y: window.scrollY,
        sheet: Boolean(panel && panel.open && panel.matches(':modal')),
      }),
    );
    target.form.requestSubmit();
  }

  document.addEventListener('astro:page-load', inicializar);
  addEventListener('change', alCambiarFiltro);
</script>
