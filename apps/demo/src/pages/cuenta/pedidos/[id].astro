---
import Container from '@pick/commerce-astro/layout/Container.astro';
import { ETIQUETA_ESTADO_PAGO, ETIQUETA_ESTADO_PEDIDO, formatMoney } from '@pick/commerce-core';
import Base from '../../../layouts/Base.astro';
import { miPedido } from '../../../lib/cuenta.ts';
import { pagos, tiendaActual } from '../../../lib/db.ts';
import { paginaDeCuenta } from '../../../lib/sesion.ts';

export const prerender = false;

const { habilitado, token } = await paginaDeCuenta(Astro.cookies);

async function noExiste(): Promise<Response> {
  const pagina = await Astro.rewrite('/404');
  return new Response(pagina.body, { status: 404, headers: pagina.headers });
}

if (!habilitado) return await noExiste();
if (!token) return Astro.redirect('/cuenta', 302);

/*
 * **No hace falta comprobar de quién es el pedido acá**, y es el punto de todo
 * el diseño: `order_json` es security invoker, así que con el JWT del comprador
 * lo filtra RLS por `app.es_mi_pedido`. Un id ajeno vuelve vacío. La defensa
 * está en la base y no en esta página, que es lo que hace que no se pueda
 * olvidar al escribir la siguiente (ADR-121).
 *
 * Un id que no existe y uno que es de otra persona dan **la misma** respuesta, y
 * también es a propósito: distinguirlos diría si ese pedido existe.
 */
const pedido = await miPedido(token, Astro.params.id!);
if (!pedido) return await noExiste();

const { locale } = await tiendaActual();
const formasDePago = await pagos();

const fecha = new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeStyle: 'short' });

/** Lo que el comprador tiene que hacer para pagar, si la tienda lo explicó. */
const instrucciones =
  pedido.paymentMethod === 'bank_transfer' && pedido.paymentStatus === 'pending'
    ? formasDePago.bankTransfer?.instructions
    : undefined;

const direccion = [
  pedido.address.street,
  pedido.address.city,
  pedido.address.zone,
  pedido.address.reference,
].filter(Boolean);
---

<Base title={`Pedido #${pedido.number}`} description="El detalle de tu pedido." noindex>
  <Container class="flex max-w-3xl flex-col gap-8 py-12">
    <div class="flex flex-col gap-2">
      <a
        href="/cuenta"
        class="self-start text-sm text-fg-muted underline underline-offset-4 hover:text-fg"
      >
        ← Mis pedidos
      </a>
      <h1 class="font-display text-2xl font-semibold tracking-tight">Pedido #{pedido.number}</h1>
      <p class="text-sm text-fg-muted">
        {fecha.format(new Date(pedido.createdAt))} · {ETIQUETA_ESTADO_PEDIDO[pedido.status]} · {
          ETIQUETA_ESTADO_PAGO[pedido.paymentStatus]
        }
      </p>
    </div>

    {
      instrucciones && (
        <section class="flex flex-col gap-2 rounded-md border border-border bg-surface-muted p-4">
          <h2 class="text-sm font-medium">Cómo pagarlo</h2>
          <p class="whitespace-pre-line text-sm text-fg-muted">{instrucciones}</p>
        </section>
      )
    }

    <section class="flex flex-col gap-3">
      <h2 class="text-lg font-medium">Lo que pediste</h2>
      <ul class="flex flex-col divide-y divide-border rounded-md border border-border">
        {
          pedido.items.map((item) => (
            <li class="flex flex-wrap items-baseline justify-between gap-2 px-4 py-3">
              <span class="flex flex-col gap-0.5">
                <span>{item.title}</span>
                {item.variantTitle && (
                  <span class="text-sm text-fg-muted">{item.variantTitle}</span>
                )}
              </span>
              <span class="text-sm text-fg-muted">
                {item.quantity} × {formatMoney(item.unitPrice, locale)}
              </span>
            </li>
          ))
        }
      </ul>

      <dl class="flex flex-col gap-1 text-sm">
        <div class="flex justify-between">
          <dt class="text-fg-muted">Subtotal</dt>
          <dd>{formatMoney(pedido.subtotal, locale)}</dd>
        </div>
        {
          pedido.discount.amount > 0 && (
            <div class="flex justify-between">
              <dt class="text-fg-muted">Descuento</dt>
              <dd>−{formatMoney(pedido.discount, locale)}</dd>
            </div>
          )
        }
        <div class="flex justify-between">
          <dt class="text-fg-muted">Envío</dt>
          <dd>
            {pedido.shipping.amount > 0 ? formatMoney(pedido.shipping, locale) : 'Sin cargo'}
          </dd>
        </div>
        <div class="flex justify-between border-t border-border pt-1 font-medium">
          <dt>Total</dt>
          <dd>{formatMoney(pedido.total, locale)}</dd>
        </div>
      </dl>
    </section>

    <section class="flex flex-col gap-2">
      <h2 class="text-lg font-medium">A dónde va</h2>
      {
        /* La dirección del pedido, no la de la cuenta: `orders.address` guarda su
          propio snapshot, así que cambiar una dirección guardada no reescribe a
          dónde se despachó esto (PROJECT.md §13). */
      }
      <p class="text-sm text-fg-muted">{direccion.join(' · ')}</p>
    </section>
  </Container>
</Base>
