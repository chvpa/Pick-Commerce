---
import Container from '@pick/commerce-astro/layout/Container.astro';
import OrderDetail from '@pick/commerce-astro/order/OrderDetail.astro';
import Base from '../../../layouts/Base.astro';
import { miPedido } from '../../../lib/cuenta.ts';
import { pagos, tiendaActual } from '../../../lib/db.ts';
import { paginaDeCuenta } from '../../../lib/sesion.ts';

export const prerender = false;

const { habilitado, token } = await paginaDeCuenta(Astro.cookies);

async function noExiste(): Promise<Response> {
  const pagina = await Astro.rewrite('/404');
  return new Response(pagina.body, { status: 404, headers: pagina.headers });
}

if (!habilitado) return await noExiste();
if (!token) return Astro.redirect('/cuenta', 302);

/*
 * **No hace falta comprobar de quién es el pedido acá**, y es el punto de todo
 * el diseño: `order_json` es security invoker, así que con el JWT del comprador
 * lo filtra RLS por `app.es_mi_pedido`. Un id ajeno vuelve vacío. La defensa
 * está en la base y no en esta página, que es lo que hace que no se pueda
 * olvidar al escribir la siguiente (ADR-121).
 *
 * Un id que no existe y uno que es de otra persona dan **la misma** respuesta, y
 * también es a propósito: distinguirlos diría si ese pedido existe.
 */
const pedido = await miPedido(token, Astro.params.id!);
if (!pedido) return await noExiste();

const { locale } = await tiendaActual();
const formasDePago = await pagos();

/** Lo que el comprador tiene que hacer para pagar, si la tienda lo explicó. */
const instrucciones =
  pedido.paymentMethod === 'bank_transfer' && pedido.paymentStatus === 'pending'
    ? formasDePago.bankTransfer?.instructions
    : undefined;
---

<Base title={`Pedido #${pedido.number}`} description="El detalle de tu pedido." noindex>
  <Container class="max-w-3xl py-12">
    <OrderDetail
      pedido={pedido}
      locale={locale}
      volverA={{ href: '/cuenta', texto: 'Mis pedidos' }}
      {...instrucciones ? { instrucciones } : {}}
    />
  </Container>
</Base>
