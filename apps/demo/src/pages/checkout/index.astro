---
import { anotar } from '../../lib/analytics.ts';
import Container from '@pick/commerce-astro/layout/Container.astro';
import { CheckoutForm } from '@pick/commerce-ui/checkout/CheckoutForm';
import Base from '../../layouts/Base.astro';
import { formatMoney } from '@pick/commerce-core';
import { envio, pagos, tiendaActual, tiendaEsDemo } from '../../lib/db.ts';
import { emailDelComprador, misDirecciones, type DireccionDeEnvio } from '../../lib/cuenta.ts';
import { paginaDeCuenta } from '../../lib/sesion.ts';

/*
 * On-demand: las formas de pago salen de la configuración de la tienda, y el
 * comercio puede cambiarlas sin que nadie reconstruya el sitio.
 */
export const prerender = false;

const ETIQUETAS: Record<string, string> = {
  bank_transfer: 'Transferencia bancaria',
  bancard: 'Tarjeta (Bancard)',
  simulated_card: 'Tarjeta (pago de prueba)',
};

const [formasDePago, esDemo, configuracionEnvio, tienda] = await Promise.all([
  pagos(),
  tiendaEsDemo(),
  envio(),
  tiendaActual(),
]);
/*
 * Las zonas de entrega con su tarifa ya escrita, para el selector del checkout.
 * Se arman acá y no en la island: el formato de moneda es del servidor, que
 * conoce la de la tienda; la island sólo muestra y manda el nombre.
 */
const zonas = (configuracionEnvio.zones ?? []).map((z) => ({
  name: z.name,
  label: `${z.name} · ${formatMoney({ amount: z.amount, currency: tienda.currency as 'PYG' }, tienda.locale)}`,
}));
const metodos = formasDePago.enabled.map((id) => ({ id, label: ETIQUETAS[id] ?? id }));

/*
 * Quien entró a su cuenta compra con el correo de su cuenta, y no puede
 * cambiarlo en este formulario.
 *
 * Es el único agujero funcional que tenía el diseño: el pedido se cuelga del
 * `customers` que lleva ese correo, así que comprar con otro lo dejaría fuera de
 * la cuenta desde la que se está comprando — y quien lo hiciera no tendría cómo
 * darse cuenta. La salida existe y es explícita: salir de la cuenta.
 *
 * La dirección por defecto, en cambio, **se precarga y se puede editar**: es
 * para no tipear el departamento otra vez, no una restricción. El pedido guarda
 * su propio snapshot igual (PROJECT.md §13).
 *
 * **El checkout guest no se toca.** Sin sesión esto es `undefined` y el
 * formulario es exactamente el de siempre; nunca se pide cuenta para comprar.
 */
const { token } = await paginaDeCuenta(Astro.cookies);

let emailFijo: string | undefined;
let direccionPrecargada: DireccionDeEnvio | undefined;

if (token) {
  try {
    const [correo, direcciones] = await Promise.all([
      emailDelComprador(token),
      misDirecciones(token),
    ]);
    emailFijo = correo ?? undefined;
    const porDefecto = direcciones.find((d) => d.isDefault) ?? direcciones[0];
    direccionPrecargada = porDefecto?.address;
  } catch (error) {
    // Comprar no puede depender de que la cuenta responda: se sigue con el
    // formulario vacío, que es el de invitada y funciona.
    console.error('[checkout] no se pudo precargar la cuenta', error);
  }
}

/*
 * Llegar al checkout es el paso del embudo, y se cuenta por sesión: recargar o
 * volver con el botón atrás no son dos intenciones de comprar. La deduplicación
 * la hace el `count(distinct session_id)` del RPC, no una clave — que alguien
 * vuelva al checkout dos días después sí es otra intención.
 */
anotar(Astro.locals, 'begin_checkout', Astro.url.pathname);
---

<Base title="Checkout" description="Confirmá tu pedido." noindex>
  <Container class="flex max-w-4xl flex-col gap-8 py-12">
    <h1 class="font-display text-2xl font-semibold tracking-tight">Confirmá tu pedido</h1>

    {
      /*
        En una tienda de demostración se avisa **antes** de confirmar, no
        después: el pedido se crea de verdad —para que se lo pueda ver entrar al
        Admin— y quien lo hace tiene que saber que no va a recibir nada.
      */
    }
    {
      esDemo && (
        <p class="rounded-md border border-border bg-surface-sunken px-4 py-3 text-sm">
          <strong>Esta es una tienda de demostración.</strong> El pedido se registra para que puedas
          verlo, pero no se cobra nada, no se despacha nada y no vas a recibir ningún correo.
        </p>
      )
    }

    <noscript>
      <p class="rounded-md border border-border bg-surface-muted px-4 py-3 text-sm">
        Para confirmar un pedido hace falta JavaScript: tu carrito se guarda en este navegador y el
        servidor no puede leerlo. Podés <a class="underline" href="/carrito">ver tu carrito</a> o escribirnos
        para comprar por otro medio.
      </p>
    </noscript>

    <CheckoutForm
      client:load
      metodos={metodos}
      metodoPorDefecto={formasDePago.default}
      zonas={zonas}
      emailFijo={emailFijo}
      direccionPrecargada={direccionPrecargada}
      locale="es-PY"
    />
  </Container>
</Base>
