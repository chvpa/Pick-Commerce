---
import Container from '@pick/commerce-astro/layout/Container.astro';
import Price from '@pick/commerce-astro/product/Price.astro';
import { AddToCart } from '@pick/commerce-ui';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { mockProducts } from '../../lib/mock-catalog.ts';

export function getStaticPaths() {
  return mockProducts.map((product) => ({
    params: { handle: product.handle },
    props: { product },
  }));
}

const { product } = Astro.props;
const variant = product.variants[0]!;
const image = product.images[0];
---

<Base title={`${product.title} · Pick Demo`} description={product.description}>
  <Container class="grid gap-10 py-12 md:grid-cols-2 md:gap-16">
    <div class="overflow-hidden rounded-md bg-surface-sunken aspect-(--aspect-product)">
      {
        image ? (
          <Image
            src={image.url}
            alt={image.alt}
            width={image.width}
            height={image.height}
            layout="constrained"
            sizes="(min-width: 768px) 50vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        ) : (
          <div
            class="flex h-full w-full items-center justify-center text-xs text-fg-subtle"
            aria-hidden="true"
          >
            Sin imagen
          </div>
        )
      }
    </div>

    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        {product.brand && <p class="text-sm text-fg-subtle">{product.brand}</p>}
        <h1 class="font-display text-2xl font-semibold tracking-tight">{product.title}</h1>
        <Price value={variant.price} compareAt={variant.compareAtPrice} class="text-lg" />
      </div>

      <dl class="flex flex-col gap-1 text-sm text-fg-muted">
        <div class="flex gap-2">
          <dt>SKU</dt>
          <dd class="text-fg">{variant.sku}</dd>
        </div>
        <div class="flex gap-2">
          <dt>Disponible</dt>
          <dd class="text-fg">{variant.availableQuantity}</dd>
        </div>
      </dl>

      {
        /*
        Única island de la página: el resto es HTML estático.
        `client:idle` porque agregar al carrito no es la primera acción del
        usuario, así que no compite con el render inicial.
      */
      }
      <AddToCart client:idle variantId={variant.id} available={variant.availableQuantity} />
    </div>
  </Container>
</Base>
