---
import Breadcrumb from '@pick/commerce-astro/navigation/Breadcrumb.astro';
import Container from '@pick/commerce-astro/layout/Container.astro';
import { ProductPurchase } from '@pick/commerce-ui';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { mockProducts } from '../../lib/mock-catalog.ts';

export function getStaticPaths() {
  return mockProducts.map((product) => ({
    params: { handle: product.handle },
    props: { product },
  }));
}

const { product } = Astro.props;
const image = product.images[0];

/* Los swatches los aporta el storefront: el catálogo guarda "Azul", no un hex. */
const COLOR_SWATCHES = { Azul: '#2f4858', Negro: '#26262b', Blanco: '#e8e6e1', Verde: '#3f5f46' };
---

<Base title={`${product.title} · Pick Demo`} description={product.description}>
  <Container class="py-6">
    <Breadcrumb items={[{ label: 'Catálogo', href: '/' }, { label: product.title }]} />
  </Container>

  <Container class="grid gap-10 pb-12 md:grid-cols-2 md:gap-16">
    <div class="overflow-hidden rounded-md bg-surface-sunken aspect-(--aspect-product)">
      {
        image ? (
          <Image
            src={image.url}
            alt={image.alt}
            width={image.width}
            height={image.height}
            layout="constrained"
            sizes="(min-width: 768px) 50vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        ) : (
          <div
            class="flex h-full w-full items-center justify-center text-xs text-fg-subtle"
            aria-hidden="true"
          >
            Sin imagen
          </div>
        )
      }
    </div>

    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        {product.brand && <p class="text-sm text-fg-subtle">{product.brand}</p>}
        <h1 class="font-display text-2xl font-semibold tracking-tight">{product.title}</h1>
      </div>

      {
        /*
        Única island de la página. Contiene precio, selector y alta al carrito
        porque los tres comparten estado, y Astro no lo pasa entre islands.
      */
      }
      <ProductPurchase client:idle variants={product.variants} swatches={COLOR_SWATCHES} />
    </div>
  </Container>
</Base>
