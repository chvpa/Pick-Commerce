---
import Hero from '@pick/commerce-astro/content/Hero.astro';
import Banner from '@pick/commerce-astro/content/Banner.astro';
import CategorySection from '@pick/commerce-astro/content/CategorySection.astro';
import Container from '@pick/commerce-astro/layout/Container.astro';
import JsonLd from '@pick/commerce-astro/seo/JsonLd.astro';
import Price from '@pick/commerce-astro/product/Price.astro';
import ProductCard from '@pick/commerce-astro/product/ProductCard.astro';
import ProductCardBody from '@pick/commerce-astro/product/ProductCardBody.astro';
import ProductCardMedia from '@pick/commerce-astro/product/ProductCardMedia.astro';
import ProductCardTitle from '@pick/commerce-astro/product/ProductCardTitle.astro';
import ProductCarousel from '@pick/commerce-astro/product/ProductCarousel.astro';
import { buttonVariants } from '@pick/commerce-ui';
import { organizationJsonLd, PRODUCTOS_POR_SECCION } from '@pick/commerce-core';
import { seoContexto } from '../lib/store-config.ts';
import { catalogo, categorias, tiendaActual } from '../lib/db.ts';
import Base from '../layouts/Base.astro';

/*
 * On-demand: las categorías, los banners y las secciones se administran, y las
 * tres cambian sin desplegar. Prerenderizada, un banner nuevo no aparecería
 * hasta el próximo deploy. Ver ADR-057.
 */
export const prerender = false;

const tienda = await tiendaActual();
const repo = catalogo();

/*
 * Qué se destaca es una decisión del comercio, **guardada**. Antes era
 * `COLECCION_DESTACADA`, una constante del storefront: un literal que sólo se
 * podía cambiar tocando código y desplegando, y que además obligaba a que toda
 * tienda llamara igual a su colección destacada.
 */
const [cats, banners, secciones] = await Promise.all([
  categorias(),
  repo.bannersPublicados(tienda.storeId),
  repo.seccionesDeHome(tienda.storeId),
]);

// Cada sección resuelve sus productos con el orden que la colección declara.
// En paralelo: son pocas y encadenarlas sumaría latencia sin motivo.
const carruseles = await Promise.all(
  secciones.map(async (s) => ({
    ...s,
    productos: await repo.porColeccion(tienda.storeId, s.handle, PRODUCTOS_POR_SECCION, s.sort),
  })),
);

const entradas = cats.map((c) => ({
  label: c.name,
  href: `/catalogo?categoria=${encodeURIComponent(c.slug)}`,
  ...(c.image ? { image: c.image } : {}),
}));
---

<Base
  title="Pick Demo · Ropa técnica para todos los días"
  description="Camperas, calzado y accesorios técnicos. Envío a todo el país."
  image="/products/campera-2.jpg"
  imageAlt="Campera cortaviento"
>
  <JsonLd slot="head" data={organizationJsonLd(seoContexto)} />
  <Container class="py-8">
    <Hero image={{ url: '/products/campera-2.jpg', alt: '', width: 900, height: 1200 }}>
      <p class="text-sm">Temporada</p>
      <h1 class="font-display max-w-lg text-3xl font-semibold sm:text-4xl">
        Ropa técnica para todos los días
      </h1>
      <a href="/catalogo" class={buttonVariants({ size: 'lg' })}>Ver catálogo</a>
    </Hero>
  </Container>

  {
    banners.length > 0 && (
      <Container class="py-8">
        <div class="grid gap-6 sm:grid-cols-2">
          {banners.map((b, i) => (
            <Banner
              image={b.image}
              imageMobile={b.imageMobile}
              title={b.title}
              subtitle={b.subtitle}
              href={b.href}
              priority={i === 0}
            />
          ))}
        </div>
      </Container>
    )
  }

  {
    entradas.length > 0 && (
      <Container class="flex flex-col gap-4 py-8">
        <h2 class="font-display text-xl font-semibold">Categorías</h2>
        <CategorySection categories={entradas} />
      </Container>
    )
  }

  {
    /* Una sección sin productos no se dibuja: un carrusel vacío bajo un título
      es peor que no mostrar nada, y una colección dinámica puede quedarse sin
      resultados sin que nadie la haya tocado. */
  }
  {
    carruseles
      .filter((c) => c.productos.length > 0)
      .map((seccion) => (
        <Container class="flex flex-col gap-4 py-8">
          <div class="flex flex-col gap-1">
            <h2 class="font-display text-xl font-semibold">{seccion.title}</h2>
            {seccion.subtitle && <p class="text-sm text-fg-muted">{seccion.subtitle}</p>}
          </div>
          <ProductCarousel label={seccion.title}>
            {seccion.productos.map((product) => {
              const variant = product.variants[0];
              if (!variant) return null;
              return (
                <ProductCard>
                  <ProductCardMedia image={product.images[0]} />
                  <ProductCardBody>
                    <ProductCardTitle href={`/productos/${product.handle}`}>
                      {product.title}
                    </ProductCardTitle>
                    <Price value={variant.price} compareAt={variant.compareAtPrice} />
                  </ProductCardBody>
                </ProductCard>
              );
            })}
          </ProductCarousel>
        </Container>
      ))
  }
</Base>
