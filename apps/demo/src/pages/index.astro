---
import HeroSlider from '@pick/commerce-astro/content/HeroSlider.astro';
import Banner from '@pick/commerce-astro/content/Banner.astro';
import CategorySection from '@pick/commerce-astro/content/CategorySection.astro';
import Container from '@pick/commerce-astro/layout/Container.astro';
import JsonLd from '@pick/commerce-astro/seo/JsonLd.astro';
import Price from '@pick/commerce-astro/product/Price.astro';
import ProductCard from '@pick/commerce-astro/product/ProductCard.astro';
import ProductCardBody from '@pick/commerce-astro/product/ProductCardBody.astro';
import ProductCardMedia from '@pick/commerce-astro/product/ProductCardMedia.astro';
import ProductCardTitle from '@pick/commerce-astro/product/ProductCardTitle.astro';
import ProductCarousel from '@pick/commerce-astro/product/ProductCarousel.astro';
import { categoriasDeLaSeccion, organizationJsonLd } from '@pick/commerce-core';

import { catalogo, categorias, contextoSeo, tiendaActual } from '../lib/db.ts';
import Base from '../layouts/Base.astro';

/*
 * On-demand: la home entera se administra —qué secciones hay, en qué orden, con
 * qué contenido— y las tres cosas cambian sin desplegar. Prerenderizada, un
 * slide nuevo no aparecería hasta el próximo deploy. Ver ADR-057.
 */
export const prerender = false;

const tienda = await tiendaActual();

/*
 * Esta página **dibuja y no decide**. El orden, el tipo y el contenido de cada
 * bloque salen de `home()`. Antes acá vivían un hero fijo y una constante con el
 * handle de la colección destacada, así que la vidriera de cualquier tienda era
 * la que este archivo dijera.
 */
const [secciones, cats] = await Promise.all([catalogo().home(tienda.storeId), categorias()]);

/**
 * Las categorías, con su enlace al catálogo filtrado.
 *
 * Qué categorías muestra cada sección y en qué orden lo decide la propia
 * sección, así que esto es el conjunto completo y cada bloque se queda con su
 * parte más abajo.
 */
const entradas = cats.map((c) => ({
  id: c.id,
  label: c.name,
  href: `/catalogo?categoria=${encodeURIComponent(c.slug)}`,
  ...(c.image ? { image: c.image } : {}),
}));

/** Columnas de un bloque de mosaicos, en clases que Tailwind pueda ver. */
const GRILLA: Readonly<Record<number, string>> = {
  1: 'grid-cols-1',
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
};
const seo = await contextoSeo();
---

<Base
  description="Camperas, calzado y accesorios técnicos. Envío a todo el país."
  image="/products/campera-2.jpg"
  imageAlt="Campera cortaviento"
>
  <JsonLd slot="head" data={organizationJsonLd(seo)} />

  {
    /*
     * El `h1` de la home, oculto a la vista.
     *
     * Antes lo aportaba el hero fijo que vivía en este archivo. Al pasar la
     * portada a secciones, una tienda sin banner principal —o con el suyo
     * despublicado— se quedaba **sin ningún `h1`**, que es una página sin
     * encabezado para un lector de pantalla y para un buscador. Los títulos de
     * las secciones son `h2` y deben seguir siéndolo: son subsecciones de la
     * portada, no su título.
     *
     * Oculto y no visible porque el hero ya dice a qué tienda entraste con su
     * propio texto, y repetirlo arriba sería ruido para quien ve la pantalla.
     */
  }
  <h1 class="sr-only">{tienda.name}</h1>

  {
    secciones.map((seccion, indice) => {
      if (seccion.kind === 'hero') {
        // Un hero sin piezas publicadas no deja un hueco negro arriba.
        if (seccion.piezas.length === 0) return null;
        return (
          <Container class="py-8">
            <HeroSlider piezas={seccion.piezas} layout={seccion.layout} id={`hero-${seccion.id}`} />
          </Container>
        );
      }

      if (seccion.kind === 'tiles') {
        if (seccion.piezas.length === 0) return null;
        return (
          <Container class="flex flex-col gap-4 py-8">
            {seccion.title && (
              <div class="flex flex-col gap-1">
                <h2 class="font-display text-xl font-semibold">{seccion.title}</h2>
                {seccion.subtitle && <p class="text-sm text-fg-muted">{seccion.subtitle}</p>}
              </div>
            )}
            {seccion.layout === 'slider' ? (
              <div
                role="group"
                aria-label={seccion.title ? `Carrusel de ${seccion.title}` : 'Carrusel de avisos'}
                tabindex="0"
                class="flex snap-x snap-mandatory gap-6 overflow-x-auto pb-2 scroll-smooth motion-reduce:scroll-auto focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&>*]:w-[85%] [&>*]:shrink-0 [&>*]:snap-start sm:[&>*]:w-[45%]"
              >
                {seccion.piezas.map((pieza, i) => (
                  <Banner
                    image={pieza.image}
                    imageMobile={pieza.imageMobile}
                    title={pieza.title}
                    subtitle={pieza.subtitle}
                    href={pieza.href}
                    priority={indice === 0 && i === 0}
                  />
                ))}
              </div>
            ) : (
              <div class:list={['grid gap-6', GRILLA[seccion.columns]]}>
                {seccion.piezas.map((pieza, i) => (
                  <Banner
                    image={pieza.image}
                    imageMobile={pieza.imageMobile}
                    title={pieza.title}
                    subtitle={pieza.subtitle}
                    href={pieza.href}
                    priority={indice === 0 && i === 0}
                  />
                ))}
              </div>
            )}
          </Container>
        );
      }

      if (seccion.kind === 'categories') {
        // La sección elige cuáles y en qué orden; sin elección, todas.
        const elegidas = categoriasDeLaSeccion(entradas, seccion.categoryIds);
        if (elegidas.length === 0) return null;
        return (
          <Container class="flex flex-col gap-4 py-8">
            {seccion.title && <h2 class="font-display text-xl font-semibold">{seccion.title}</h2>}
            <CategorySection categories={elegidas} layout={seccion.layout} />
          </Container>
        );
      }

      /* Un carrusel vacío bajo un título es peor que no mostrar nada, y una
         colección dinámica puede quedarse sin resultados sin que nadie la haya
         tocado. */
      if (seccion.productos.length === 0) return null;

      return (
        <Container class="flex flex-col gap-4 py-8">
          <div class="flex flex-col gap-1">
            {seccion.title && <h2 class="font-display text-xl font-semibold">{seccion.title}</h2>}
            {seccion.subtitle && <p class="text-sm text-fg-muted">{seccion.subtitle}</p>}
          </div>
          <ProductCarousel label={seccion.title ?? 'Productos'}>
            {seccion.productos.map((product) => {
              const variant = product.variants[0];
              if (!variant) return null;
              return (
                <ProductCard>
                  <ProductCardMedia image={product.images[0]} />
                  <ProductCardBody>
                    <ProductCardTitle href={`/productos/${product.handle}`}>
                      {product.title}
                    </ProductCardTitle>
                    <Price value={variant.price} compareAt={variant.compareAtPrice} />
                  </ProductCardBody>
                </ProductCard>
              );
            })}
          </ProductCarousel>
        </Container>
      );
    })
  }
</Base>
