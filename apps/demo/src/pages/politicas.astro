---
/*
 * On-demand, aunque su contenido no salga de la base.
 *
 * Con Workers Assets una página en disco se sirve **sin ejecutar el Worker**, y
 * el encabezado y el pie llevan el nombre de la tienda, que sí sale de la base.
 * Prerenderizada, hornearía el nombre de la que estuviera configurada al
 * construir y se lo mostraría a todas.
 */
export const prerender = false;
import Container from '@pick/commerce-astro/layout/Container.astro';
import Base from '../layouts/Base.astro';
import { POLITICAS } from '../lib/contenido.ts';
import { COOKIE_SIN_PERSONALIZACION } from '../lib/analytics.ts';

/*
 * El estado del interruptor sale de la cookie y no de un parámetro de la URL: el
 * parámetro sólo sirve para confirmar el cambio recién hecho, y compartir el
 * enlace no tiene que mentirle a nadie sobre cómo está su propia preferencia.
 */
const personalizado = !Astro.cookies.get(COOKIE_SIN_PERSONALIZACION)?.value;
const aviso = Astro.url.searchParams.get('personalizacion');
---

<Base title="Políticas" description="Políticas de envío, cambios, devoluciones y privacidad.">
  <Container class="flex max-w-3xl flex-col gap-10 py-12">
    <h1 class="font-display text-2xl font-semibold tracking-tight">Políticas</h1>

    {
      POLITICAS.map((seccion) => (
        <section class="flex flex-col gap-3">
          <h2 class="text-lg font-semibold">{seccion.titulo}</h2>
          {seccion.parrafos.map((p) => (
            <p class="max-w-prose text-fg-muted">{p}</p>
          ))}
        </section>
      ))
    }

    {
      /*
      El interruptor, y no un banner. Vive acá —donde está la explicación— y no
      en una cinta que aparece encima de todo: un banner lo descarta todo el
      mundo sin leerlo, así que no da una elección, da un clic.

      Sin JavaScript: es un `<form>` que la ruta procesa y contesta con una
      redirección.
    */
    }
    <section id="personalizacion" class="flex flex-col gap-3">
      <h2 class="text-lg font-semibold">Personalización</h2>
      <p class="max-w-prose text-fg-muted">
        Recordamos qué miraste en este navegador para poder ordenar mejor lo que te mostramos. Es un
        identificador al azar que dura seis meses y se renueva cada vez que volvés; no lleva tu
        nombre ni tu correo, y no se cruza con tu cuenta.
      </p>

      {
        aviso === 'apagada' && (
          <p role="status" class="max-w-prose rounded-sm bg-surface-muted px-4 py-3 text-sm">
            Listo: apagamos la personalización y borramos el identificador de este navegador.
          </p>
        )
      }
      {
        aviso === 'prendida' && (
          <p role="status" class="max-w-prose rounded-sm bg-surface-muted px-4 py-3 text-sm">
            Listo: volvimos a personalizar. El identificador empieza de cero.
          </p>
        )
      }

      <form method="post" action="/api/preferencias" class="self-start">
        <input type="hidden" name="accion" value={personalizado ? 'apagar' : 'prender'} />
        <button
          type="submit"
          class="cursor-pointer rounded-sm border border-border px-4 py-2 text-sm hover:border-border-strong"
        >
          {personalizado ? 'Desactivar la personalización' : 'Activar la personalización'}
        </button>
      </form>

      <p class="max-w-prose text-sm text-fg-subtle">
        {
          personalizado
            ? 'Está activada. Al desactivarla borramos el identificador; las visitas siguen contándose de forma anónima, como las de cualquiera.'
            : 'Está desactivada en este navegador. No guardamos ningún identificador que dure más que tu visita.'
        }
      </p>
    </section>
  </Container>
</Base>
