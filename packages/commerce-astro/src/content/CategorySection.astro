---
import { Image } from 'astro:assets';
import type { ProductImage } from '@pick/commerce-types';
import { cn } from '@pick/commerce-ui';
import { medidasParaMostrar } from '@pick/commerce-core';

export interface CategoryEntry {
  label: string;
  href: string;
  image?: ProductImage;
}

interface Props {
  categories: readonly CategoryEntry[];
  /**
   * `slider` las pasa de a una en una fila que se desliza; `static` las apila en
   * grilla. Con muchas categorías la grilla crece hacia abajo y empuja el resto
   * de la portada, así que el carrusel deja de ser un adorno.
   */
  layout?: 'static' | 'slider';
  class?: string;
}

const { categories, layout = 'static', class: className } = Astro.props;
---

{/* Carrusel por scroll-snap, sin JavaScript, igual que el de productos (ADR-038). */}
<ul
  class={cn(
    layout === 'slider'
      ? [
          'flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2',
          'scroll-smooth motion-reduce:scroll-auto',
          'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
          '[scrollbar-width:thin]',
          '[&>li]:w-36 [&>li]:shrink-0 [&>li]:snap-start sm:[&>li]:w-44',
        ]
      : 'grid grid-cols-2 gap-4 md:grid-cols-4',
    className,
  )}
  {...layout === 'slider' ? { role: 'group', tabindex: '0', 'aria-label': 'Categorías' } : {}}
>
  {
    categories.map((category) => (
      <li>
        <a
          href={category.href}
          class="group flex flex-col gap-3 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        >
          <div class="aspect-[4/3] overflow-hidden rounded-md bg-surface-sunken">
            {category.image && (
              <Image
                src={category.image.url}
                alt=""
                {...medidasParaMostrar(category.image, 400)}
                layout="constrained"
                sizes="(min-width: 768px) 25vw, 50vw"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
              />
            )}
          </div>
          <span class="text-sm font-medium group-hover:underline">{category.label}</span>
        </a>
      </li>
    ))
  }
</ul>
