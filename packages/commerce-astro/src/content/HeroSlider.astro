---
import { Image } from 'astro:assets';
import { medidasParaMostrar } from '@pick/commerce-core';
import type { Banner } from '@pick/commerce-core';
import { buttonVariants, cn } from '@pick/commerce-ui';
import CarouselControls from '../primitives/CarouselControls.astro';

interface Props {
  piezas: readonly Banner[];
  /**
   * `slider` pasa los slides de a uno; `static` los pone **de a dos**.
   *
   * Apilarlos uno debajo del otro no es una opción: un hero ocupa el alto de la
   * pantalla, y tres apilados empujan el catálogo tan abajo que nadie llega. Con
   * uno solo las dos opciones dan lo mismo.
   */
  layout: 'static' | 'slider';
  /** Para que los `id` de los slides no choquen si hay dos heros. */
  id: string;
  /**
   * Clases para cada slide. Es lo que decide su alto: por defecto el slide mide
   * lo que mide su texto y la foto se recorta a eso; un hero a pantalla
   * completa se pide desde acá con un `min-h`, y no desde `class`, que va en la
   * sección y dejaría el hueco debajo del slide en vez de agrandarlo.
   */
  slideClass?: string;
  /**
   * Flechas a los lados, y auto-avance si `autoplay` trae milisegundos. Es
   * opt-in y trae JavaScript: el hero sin esto sigue deslizando por scroll
   * nativo, que es el default del paquete (ADR-038).
   */
  controles?: boolean;
  autoplay?: number;
  class?: string;
}

const {
  piezas,
  layout,
  id,
  slideClass,
  controles = false,
  autoplay,
  class: className,
} = Astro.props;

/*
 * Con **una sola pieza** las dos opciones dan lo mismo, y esa pieza va a ancho
 * completo.
 *
 * Antes el caso de una pieza caía en la rama estática, que es una grilla de dos
 * columnas: el banner único se dibujaba a media pantalla con la otra mitad
 * vacía. Desde el Admin eso se veía como «elegí slides y no pasó nada, quedó de
 * a dos», que fue exactamente el reporte.
 */
const unaSola = piezas.length <= 1;
const esSlider = layout === 'slider' && !unaSola;
---

{
  /*
  Slideshow por scroll-snap, sin JavaScript, igual que el carrusel de productos
  y la galería del PDP (ADR-038). El scroll horizontal es nativo en touch y
  trackpad, el contenedor es focusable para el teclado, y los puntos de abajo son
  anclas: `#slide-2` lleva al slide 2 sin una línea de script.

  **El auto-avance y las flechas son opt-in** (`controles`, `autoplay`). Por
  defecto no hay: exigen JavaScript en la home, que es la página más liviana del
  sitio y tiene su presupuesto medido, y un hero que se mueve solo se lleva
  puesto a quien está leyendo. Un cliente lo pidió, y entró como pidió el repo:
  un script chico que respeta `prefers-reduced-motion` y se detiene mientras
  alguien mira o toca. Ver `primitives/carrusel-controles.ts`.
*/
}
<section
  class={cn('flex flex-col gap-3', className)}
  aria-roledescription={esSlider ? 'carrusel' : undefined}
  aria-label={esSlider ? 'Destacados de la tienda' : undefined}
>
  {/* El `relative` es para las flechas, que van encima de los slides. */}
  <div class="relative">
    <div
      id={id}
      {...esSlider ? { role: 'group', tabindex: '0' } : {}}
      class={cn(
        esSlider
          ? [
              'flex snap-x snap-mandatory overflow-x-auto scroll-smooth motion-reduce:scroll-auto',
              'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
              '[scrollbar-width:none] [&::-webkit-scrollbar]:hidden',
            ]
          : // De a dos en pantalla ancha y uno por fila en teléfono, donde dos
            // heros lado a lado no dejan leer ninguno. Con una sola pieza, ancho
            // completo: media pantalla vacía al lado no es un layout, es un error.
            ['grid gap-4', !unaSola && 'sm:grid-cols-2'],
        'rounded-lg',
      )}
    >
      {
        piezas.map((pieza, i) => (
          <article
            id={`${id}-${i}`}
            class={cn(
              'relative isolate flex flex-col justify-end overflow-hidden rounded-lg bg-media',
              esSlider && 'w-full shrink-0 snap-center',
              slideClass,
            )}
            aria-label={esSlider ? `${i + 1} de ${piezas.length}` : undefined}
          >
            <picture>
              {pieza.imageMobile && <source media="(min-width: 640px)" srcset={pieza.image.url} />}
              <Image
                src={(pieza.imageMobile ?? pieza.image).url}
                alt={(pieza.imageMobile ?? pieza.image).alt}
                {...medidasParaMostrar(pieza.imageMobile ?? pieza.image, 1600)}
                layout="full-width"
                sizes="100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                decoding="async"
                class="absolute inset-0 -z-10 h-full w-full object-cover"
              />
            </picture>

            {/* Velo sólo acá, donde el texto va encima de la foto: es un hero y
              esa es su forma. En los mosaicos el texto va debajo justamente
              para no necesitarlo. Sin gradient decorativo — ADR-027. */}
            <div class="absolute inset-0 -z-10 bg-black/40" aria-hidden="true" />

            <div class="flex flex-col items-start gap-4 px-6 py-20 text-white sm:px-10 sm:py-28">
              <h2 class="font-display max-w-lg text-3xl font-semibold sm:text-4xl">
                {pieza.title}
              </h2>
              {pieza.subtitle && <p class="max-w-lg text-sm sm:text-base">{pieza.subtitle}</p>}
              {/* Con texto de botón se dibuja un botón; sin él, y con enlace, el
                 título entero lleva. Un hero sin `href` es sólo una imagen con
                 texto, que también es un uso válido. */}
              {pieza.href && pieza.ctaLabel && (
                <a href={pieza.href} class={buttonVariants({ size: 'lg' })}>
                  {pieza.ctaLabel}
                </a>
              )}
              {/*
               * Sin texto de botón, el slide entero es el enlace y no se escribe
               * nada encima: el arte del comercio ya dice lo suyo, y un «Ver
               * más» genérico pegado abajo lo pisaba. El nombre queda para el
               * lector de pantalla y el foco se ve en el borde del slide.
               */}
              {pieza.href && !pieza.ctaLabel && (
                <a
                  href={pieza.href}
                  class="absolute inset-0 rounded-lg focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-white"
                >
                  <span class="sr-only">{`Ver ${pieza.title}`}</span>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
    {
      controles && esSlider && (
        <CarouselControls pista={id} label="destacados" autoplay={autoplay} />
      )
    }
  </div>

  {
    esSlider && (
      <nav aria-label="Ir a un destacado" class="flex justify-center gap-2">
        {piezas.map((pieza, i) => (
          <a
            href={`#${id}-${i}`}
            class="cursor-pointer rounded-full border border-border-strong p-1.5 transition-colors hover:bg-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            <span class="sr-only">{`Ir a ${pieza.title}`}</span>
          </a>
        ))}
      </nav>
    )
  }
</section>
