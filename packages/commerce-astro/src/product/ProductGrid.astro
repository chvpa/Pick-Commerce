---
import { cn } from '@pick/commerce-ui';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{
  /*
  Las columnas crecen por breakpoint. Cuando aparezca un caso real de grid
  dentro de una columna angosta se evalúa `@container`, no antes.
*/
}
<div class={cn('grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4', className)}>
  <slot />
</div>
