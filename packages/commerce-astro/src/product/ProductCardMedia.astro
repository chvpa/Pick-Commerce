---
import { Image } from 'astro:assets';
import type { ProductImage } from '@pick/commerce-types';
import { cn } from '@pick/commerce-ui';

interface Props {
  image?: ProductImage;
  /** `true` sólo para las primeras cards del PLP: evita diferir el LCP. */
  priority?: boolean;
  /**
   * Ancho que ocupará la imagen en cada breakpoint. Debe reflejar el grid real
   * que la contiene, si no el browser elige del `srcset` un archivo equivocado.
   */
  sizes?: string;
  class?: string;
}

const {
  image,
  priority = false,
  sizes = '(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw',
  class: className,
} = Astro.props;
---

<div
  class={cn('relative overflow-hidden rounded-md bg-media', 'aspect-(--aspect-product)', className)}
>
  {
    image ? (
      /*
       * `<Image />` en vez de `<img>`: genera srcset, convierte formato y fija
       * width/height para evitar CLS. Para que además optimice, el storefront
       * debe autorizar el host de sus medios en `image.remotePatterns`.
       */
      <Image
        src={image.url}
        alt={image.alt}
        width={image.width}
        height={image.height}
        layout="constrained"
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        class="h-full w-full [object-fit:var(--fit-product)] transition-transform duration-300 ease-out group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
      />
    ) : (
      /* Sin imagen la card conserva su altura: el grid no salta. */
      <div
        class="flex h-full w-full items-center justify-center text-xs text-fg-subtle"
        aria-hidden="true"
      >
        Sin imagen
      </div>
    )
  }

  {/* Slot para badges: "Nuevo", "-30%", "Sin stock". */}
  <div class="absolute top-2 left-2 flex flex-col items-start gap-1">
    <slot name="badge" />
  </div>

  {
    /*
    Slot para una acción sobre la foto: hoy el corazón.
    
    Arriba a la derecha, que es donde se lo busca, y **por encima del enlace que
    se estira sobre la card**: `ProductCard` deja el `after:absolute` del título
    cubriendo todo, así que sin `z-10` el clic abriría el producto en vez de
    guardarlo. El fondo semitransparente es porque va sobre una foto que puede
    ser de cualquier color.
  */
  }
  <div class="absolute top-2 right-2 z-10 rounded-full bg-surface/80 p-1.5 backdrop-blur-sm">
    <slot name="accion" />
  </div>
</div>
